  # ===== Network Scanner Module =====
  class NetworkScanner
    def initialize(framework, cidr)
      @framework = framework
      @cidr = cidr
    end

    def scan
      @framework.print_status("Scanning network #{@cidr}")
      hosts = discover_hosts
      results = {}
      
      Parallel.each(hosts, in_threads: 10) do |host|
        results[host] = {
          open_ports: scan_ports(host),
          services: identify_services(host),
          vulnerabilities: scan_vulnerabilities(host)
        }
      end
      
      results
    end

    private

    def discover_hosts
      # Simple ping sweep
      network = IPAddr.new(@cidr)
      hosts = []
      
      network.to_range.each do |ip|
        next if ip == network.broadcast || ip == network.network
        
        if system("ping -c 1 -W 1 #{ip} > /dev/null 2>&1")
          hosts << ip.to_s
        end
      end
      
      hosts
    end

    def scan_ports(host)
      # Scan common ports
      common_ports = [21, 22, 23, 25, 53, 80, 110, 135, 139, 143, 443, 445, 993, 995, 1723, 3306, 3389, 5900, 8080]
      open_ports = []
      
      common_ports.each do |port|
        begin
          socket = TCPSocket.new(host, port)
          open_ports << port
          socket.close
        rescue
          # Port closed
        end
      end
      
      open_ports
    end

    def identify_services(host)
      # Simple service identification
      services = {}
      scan_ports(host).each do |port|
        case port
        when 22
          services[port] = 'SSH'
        when 80, 443
          services[port] = 'HTTP/HTTPS'
        when 445
          services[port] = 'SMB'
        when 3389
          services[port] = 'RDP'
        else
          services[port] = 'Unknown'
        end
      end
      services
    end

    def scan_vulnerabilities(host)
      # Simple vulnerability check based on open ports
      vulns = []
      open_ports = scan_ports(host)
      
      vulns << 'SMBv1 Vulnerability' if open_ports.include?(445)
      vulns << 'Heartbleed Vulnerability' if open_ports.include?(443)
      vulns << 'SSH Weak Algorithms' if open_ports.include?(22)
      
      vulns
    end
  end

